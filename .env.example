# MongoDB connection string (Railway MongoDB service provides MONGO_URL)
MONGODB_URI=mongodb://localhost:27017/marrow
MONGODB_DB=marrow

# OpenRouter API key (powers the 4-Model Ensemble and all curated 2026 models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Routing mode: "ensemble" (default: 4 distinct models) or "single"
LLM_ROUTING_MODE=ensemble
LLM_MODEL=meta/muse-ember
