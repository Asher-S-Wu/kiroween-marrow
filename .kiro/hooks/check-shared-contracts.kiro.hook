{
  "name": "Check both arena contracts",
  "description": "Type-check both applications after an arena's contract or the shared schema changes.",
  "version": "1.0.0",
  "enabled": true,
  "when": {
    "type": "fileEdited",
    "patterns": ["src/apps/**/domain.spec.ts", "src/skeleton/schema/**/*.ts"]
  },
  "then": {
    "type": "runCommand",
    "command": "npm run typecheck"
  }
}
